# FerrousCX IAM Local Development Environment Configuration
# Copy this file to .env before starting: cp .env.example .env
# NOTE: .env is git-ignored to prevent credential leakage.

# Kanidm Administrative Account (Used for Web UI at https://localhost:8443)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<REPLACE_WITH_SECURE_ADMIN_PASSWORD>

# FerrousCX Human Personas
CARLOS_SUPPORT_PASSWORD=<REPLACE_WITH_CARLOS_PASSWORD>
OPS_LEAD_PASSWORD=<REPLACE_WITH_OPS_LEAD_PASSWORD>

# Kanidm OIDC Client ID
FERROUS_FRONTEND_CLIENT_ID=ferrous-frontend
